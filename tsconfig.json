{
  "compilerOptions": {
    "noEmit": true,
    "declaration": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "NodeNext",
    "lib": ["DOM", "ES2020"],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "./lib",
    "types": ["node"]
  },
  "include": ["./src/**/*"]
}
