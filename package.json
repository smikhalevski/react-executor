{
  "name": "react-executor",
  "version": "0.0.29",
  "description": "Asynchronous task execution and state management for React.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./ssr": "./ssr/index.js",
    "./observable/navigatorOffline": "./observable/navigatorOffline.js",
    "./observable/navigatorOnline": "./observable/navigatorOnline.js",
    "./observable/windowBlurred": "./observable/windowBlurred.js",
    "./observable/windowFocused": "./observable/windowFocused.js",
    "./plugin/abortDeactivated": "./plugin/abortDeactivated.js",
    "./plugin/abortPendingAfter": "./plugin/abortPendingAfter.js",
    "./plugin/abortWhen": "./plugin/abortWhen.js",
    "./plugin/detachDeactivated": "./plugin/detachDeactivated.js",
    "./plugin/detachInactive": "./plugin/detachInactive.js",
    "./plugin/invalidateAfter": "./plugin/invalidateAfter.js",
    "./plugin/invalidateByPeers": "./plugin/invalidateByPeers.js",
    "./plugin/invalidatePeers": "./plugin/invalidatePeers.js",
    "./plugin/invalidateWhen": "./plugin/invalidateWhen.js",
    "./plugin/lazyTask": "./plugin/lazyTask.js",
    "./plugin/rejectPendingAfter": "./plugin/rejectPendingAfter.js",
    "./plugin/resolveBy": "./plugin/resolveBy.js",
    "./plugin/retryActivated": "./plugin/retryActivated.js",
    "./plugin/retryFulfilled": "./plugin/retryFulfilled.js",
    "./plugin/retryInvalidated": "./plugin/retryInvalidated.js",
    "./plugin/retryRejected": "./plugin/retryRejected.js",
    "./plugin/retryWhen": "./plugin/retryWhen.js",
    "./plugin/syncBrowserStorage": "./plugin/syncBrowserStorage.js",
    "./plugin/syncExternalStore": "./plugin/syncExternalStore.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json && cp package.json README.md LICENSE.txt lib/ && cd lib && npm pkg delete scripts devDependencies",
    "clean": "rimraf lib docs coverage",
    "test": "NODE_OPTIONS=--no-webstorage vitest run",
    "typecheck": "tsc",
    "lint": "oxlint --tsconfig tsconfig.json src/main",
    "format": "oxfmt 'src/**/*.{ts,js}'",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smikhalevski/react-executor.git"
  },
  "keywords": [
    "react",
    "hook",
    "executor"
  ],
  "author": "Savva Mikhalevski <smikhalevski@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/smikhalevski/react-executor/issues"
  },
  "homepage": "https://megastack.dev/react-executor",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
